# ============================================================
# Netlify Headers Configuration
# Arabian Amenity Travels
# ============================================================

# ── HTML files — never cache, always fresh ──────────────────
# index.html must always be the latest version so users
# always get the newest deploy immediately
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# ── Hashed JS and CSS assets — cache forever ────────────────
# Vite adds a unique hash to filenames on every build
# e.g. index-BEvFcAxz.css — if content changes, filename changes
# so it is safe to cache these forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Images — cache for 30 days ──────────────────────────────
# Images don't change often but may be updated occasionally
# 30 days is a good balance between performance and freshness
/images/*
  Cache-Control: public, max-age=2592000, immutable

# ── Fonts — cache forever ───────────────────────────────────
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ── Security Headers ────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()